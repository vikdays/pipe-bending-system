# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Wails v3
/apps/desktop/bin/
/apps/desktop/.task/
/apps/desktop/frontend/bindings/
/apps/desktop/frontend/.bindings-tmp-*/
/apps/desktop/*.syso

