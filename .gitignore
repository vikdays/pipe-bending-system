*.db
*.db-*
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*

# installation packages and signing material
*.apk
*.aab
*.exe
*.msi
*.keystore
/apps/mobile/credentials.json

# lint cache
.eslintcache
