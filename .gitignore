# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env.*
!.env.example

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android
/apps/mobile/ios/
/apps/mobile/android/

# desktop generated bindings and compiled binaries
/apps/desktop/build/bin/
/apps/desktop/frontend/wailsjs/

# runtime databases (device-specific, never source files)
*.db
*.db-*
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*

# installation packages and signing material
*.apk
*.aab
*.exe
*.msi
*.keystore

# lint cache
.eslintcache
