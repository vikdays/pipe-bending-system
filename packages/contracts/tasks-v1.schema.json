{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pipe-bending:tasks:v1",
  "title": "Pipe bending task package v1",
  "description": "All prepared tasks, ordered by queuePosition. Each task contains immutable snapshots and a stable UUID. No authentication data or binary attachments.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "schemaVersion",
    "tasks"
  ],
  "properties": {
    "format": {
      "const": "pipe-bending.tasks"
    },
    "schemaVersion": {
      "const": 1
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/ExportedTask"
      },
      "description": "Ascending queuePosition; unique task UUIDs."
    }
  },
  "$defs": {
    "ExportedTask": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "revision",
        "number",
        "queuePosition",
        "bendNumber",
        "bendType",
        "targetAngleDeg",
        "notes",
        "createdAt",
        "preparedAt",
        "snapshotVersion",
        "pipeSnapshot",
        "configurationSnapshot",
        "machineSnapshot"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "description": "Постоянный UUID задания для обмена. Не меняется при повторной выгрузке."
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "number": {
          "type": "string",
          "minLength": 1
        },
        "queuePosition": {
          "type": "integer",
          "minimum": 1
        },
        "bendNumber": {
          "type": "string",
          "minLength": 1
        },
        "bendType": {
          "enum": [
            "1ГО",
            "2ГО"
          ]
        },
        "targetAngleDeg": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "notes": {
          "type": "string"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "preparedAt": {
          "type": "string",
          "format": "date-time"
        },
        "snapshotVersion": {
          "type": "integer",
          "const": 1
        },
        "pipeSnapshot": {
          "$ref": "#/$defs/ExportedPipe"
        },
        "configurationSnapshot": {
          "$ref": "#/$defs/ExportedConfiguration"
        },
        "machineSnapshot": {
          "$ref": "#/$defs/Machine"
        }
      }
    },
    "ExportedPipe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inventoryNumber",
        "factoryNumber",
        "manufacturer",
        "diameterMm",
        "wallThicknessMm",
        "lengthMm",
        "massKg",
        "strengthClass",
        "steelGrade",
        "heatNumber",
        "carbonEquivalentPct",
        "pipeSpecification",
        "coatingType",
        "coatingSpecification",
        "testPressureMpa",
        "minOperatingTempC",
        "incomingInspectionReference",
        "allowedCategory54",
        "allowedCategory74",
        "notes",
        "attributesJson",
        "sourceId",
        "revision",
        "certificates"
      ],
      "properties": {
        "inventoryNumber": {
          "type": "string",
          "minLength": 1
        },
        "factoryNumber": {
          "type": "string",
          "minLength": 1
        },
        "manufacturer": {
          "type": "string"
        },
        "diameterMm": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "wallThicknessMm": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "lengthMm": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "massKg": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "strengthClass": {
          "type": "string"
        },
        "steelGrade": {
          "type": "string"
        },
        "heatNumber": {
          "type": "string"
        },
        "carbonEquivalentPct": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "pipeSpecification": {
          "type": "string"
        },
        "coatingType": {
          "type": "string"
        },
        "coatingSpecification": {
          "type": "string"
        },
        "testPressureMpa": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "minOperatingTempC": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "incomingInspectionReference": {
          "type": "string"
        },
        "allowedCategory54": {
          "type": "string"
        },
        "allowedCategory74": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        },
        "attributesJson": {
          "type": "string",
          "description": "JSON-объект дополнительных сведений трубы в строке, совместимой с текущим реестром. Неизвестные ключи сохраняются.",
          "contentMediaType": "application/json",
          "contentSchema": {
            "type": "object"
          }
        },
        "sourceId": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "certificates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Certificate"
          }
        }
      }
    },
    "ExportedConfiguration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceId",
        "revision",
        "name",
        "version",
        "technicalCardReference",
        "diameterMm",
        "bendType",
        "targetAngle",
        "minPipeLengthMm",
        "parameters",
        "notes"
      ],
      "properties": {
        "sourceId": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "technicalCardReference": {
          "type": "string",
          "minLength": 1
        },
        "diameterMm": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "bendType": {
          "type": "string"
        },
        "targetAngle": {
          "type": "string"
        },
        "minPipeLengthMm": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "parameters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ConfigurationParameter"
          }
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "Machine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "model",
        "serialNumber",
        "inventoryNumber"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "serialNumber": {
          "type": "string"
        },
        "inventoryNumber": {
          "type": "string"
        }
      }
    },
    "Certificate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference",
        "number",
        "issuedOn",
        "pageCount",
        "issuer",
        "id"
      ],
      "properties": {
        "reference": {
          "type": "string"
        },
        "number": {
          "type": "string",
          "minLength": 1
        },
        "issuedOn": {
          "type": "string"
        },
        "pageCount": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "issuer": {
          "type": "string"
        },
        "id": {
          "type": "string"
        }
      }
    },
    "ConfigurationParameter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "value",
        "unit"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "string"
        },
        "unit": {
          "type": "string"
        }
      }
    }
  }
}
